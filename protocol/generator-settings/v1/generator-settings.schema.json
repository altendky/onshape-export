{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/altendky/onshape-export/protocol/generator-settings/v1/generator-settings.schema.json",
  "title": "Onshape Export Generator Settings v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "blockers"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "blockers": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/blocker" }
    }
  },
  "$defs": {
    "objectIdentity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[!-~]+$"
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectIdentity", "targets"],
      "properties": {
        "objectIdentity": { "$ref": "#/$defs/objectIdentity" },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/objectIdentity" }
        }
      }
    }
  }
}
