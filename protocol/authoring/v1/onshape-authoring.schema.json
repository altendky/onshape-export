{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/altendky/onshape-export/protocol/authoring/v1/onshape-authoring.schema.json",
  "title": "Onshape Export Authoring Reference v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "objects"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "objects": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/object" }
    }
  },
  "$defs": {
    "sourceValue": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[!-~]+$"
    },
    "key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"
    },
    "partStudioPart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "documentId",
        "documentMicroversion",
        "elementId",
        "configurationIdentity",
        "partId"
      ],
      "properties": {
        "kind": { "const": "partStudioPart" },
        "documentId": { "$ref": "#/$defs/sourceValue" },
        "documentMicroversion": { "$ref": "#/$defs/sourceValue" },
        "elementId": { "$ref": "#/$defs/sourceValue" },
        "configurationIdentity": { "$ref": "#/$defs/sourceValue" },
        "partId": { "$ref": "#/$defs/sourceValue" }
      }
    },
    "assemblyOccurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "documentId",
        "documentMicroversion",
        "elementId",
        "configurationIdentity",
        "occurrencePath"
      ],
      "properties": {
        "kind": { "const": "assemblyOccurrence" },
        "documentId": { "$ref": "#/$defs/sourceValue" },
        "documentMicroversion": { "$ref": "#/$defs/sourceValue" },
        "elementId": { "$ref": "#/$defs/sourceValue" },
        "configurationIdentity": { "$ref": "#/$defs/sourceValue" },
        "occurrencePath": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/sourceValue" }
        }
      }
    },
    "selector": {
      "oneOf": [
        { "$ref": "#/$defs/partStudioPart" },
        { "$ref": "#/$defs/assemblyOccurrence" }
      ]
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "targets"],
      "properties": {
        "role": { "enum": ["printable", "supportBlocker"] },
        "key": { "$ref": "#/$defs/key" },
        "targets": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/key" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "role": { "const": "printable" } } },
          "then": { "properties": { "targets": { "maxItems": 0 } } },
          "else": { "properties": { "targets": { "minItems": 1 } } }
        }
      ]
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "displayName", "annotation"],
      "properties": {
        "selector": { "$ref": "#/$defs/selector" },
        "displayName": { "$ref": "#/$defs/displayName" },
        "annotation": { "$ref": "#/$defs/annotation" }
      }
    }
  }
}
