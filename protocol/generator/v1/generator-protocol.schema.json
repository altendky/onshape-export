{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/altendky/onshape-export/protocol/generator/v1/generator-protocol.schema.json",
  "title": "Onshape Export Neutral Generator Protocol v1",
  "oneOf": [
    { "$ref": "#/$defs/inputManifest" },
    { "$ref": "#/$defs/generatorRequest" },
    { "$ref": "#/$defs/generatorResult" }
  ],
  "$defs": {
    "opaqueIdentity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[!-~]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
    },
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "displayText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "mediaType": {
      "type": "string",
      "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$"
    },
    "safeByteLength": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "fileContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contentIdentity",
        "path",
        "sha256",
        "byteLength",
        "mediaType",
        "detectedKindIdentity"
      ],
      "properties": {
        "contentIdentity": { "$ref": "#/$defs/opaqueIdentity" },
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byteLength": { "$ref": "#/$defs/safeByteLength" },
        "mediaType": { "$ref": "#/$defs/mediaType" },
        "detectedKindIdentity": { "$ref": "#/$defs/opaqueIdentity" }
      }
    },
    "mappingStatus": {
      "enum": ["proven", "unproven", "missing", "duplicate", "ambiguous"]
    },
    "mappingEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "evidenceIdentity"],
      "properties": {
        "classification": { "$ref": "#/$defs/opaqueIdentity" },
        "evidenceIdentity": { "$ref": "#/$defs/opaqueIdentity" }
      }
    },
    "objectMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "$ref": "#/$defs/mappingStatus" },
        "evidence": { "$ref": "#/$defs/mappingEvidence" },
        "reason": { "$ref": "#/$defs/boundedText" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "proven" } } },
          "then": {
            "required": ["evidence"],
            "not": { "required": ["reason"] }
          },
          "else": { "required": ["reason"] }
        }
      ]
    },
    "inputObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectIdentity", "role", "retainedContent", "mapping"],
      "properties": {
        "objectIdentity": { "$ref": "#/$defs/opaqueIdentity" },
        "role": { "enum": ["rawGeometry", "auxiliaryGeometry"] },
        "retainedContent": { "$ref": "#/$defs/fileContent" },
        "mapping": { "$ref": "#/$defs/objectMapping" },
        "sourceObjectIdentity": { "$ref": "#/$defs/opaqueIdentity" },
        "occurrencePath": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/opaqueIdentity" }
        },
        "producerResultIdentity": { "$ref": "#/$defs/opaqueIdentity" },
        "sourceFilename": { "$ref": "#/$defs/displayText" },
        "displayName": { "$ref": "#/$defs/displayText" },
        "parentObjectIdentity": { "$ref": "#/$defs/opaqueIdentity" }
      }
    },
    "exportInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kindIdentity",
        "schemaIdentity",
        "groupingPolicy",
        "observationStatus"
      ],
      "properties": {
        "kindIdentity": { "$ref": "#/$defs/opaqueIdentity" },
        "schemaIdentity": { "$ref": "#/$defs/opaqueIdentity" },
        "groupingPolicy": { "enum": ["grouped", "individual"] },
        "observationStatus": { "$ref": "#/$defs/mappingStatus" },
        "observationEvidenceIdentity": { "$ref": "#/$defs/opaqueIdentity" }
      },
      "allOf": [
        {
          "if": { "properties": { "observationStatus": { "const": "proven" } } },
          "then": { "required": ["observationEvidenceIdentity"] },
          "else": { "not": { "required": ["observationEvidenceIdentity"] } }
        }
      ]
    },
    "manifestDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["available", "unavailable"] },
        "reason": { "$ref": "#/$defs/boundedText" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "available" } } },
          "then": { "not": { "required": ["reason"] } },
          "else": { "required": ["reason"] }
        }
      ]
    },
    "inputManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentType",
        "protocolVersion",
        "manifestVersion",
        "manifestIdentity",
        "requirementsIdentity",
        "sourceIdentity",
        "configurationIdentity",
        "export",
        "decision",
        "objects"
      ],
      "properties": {
        "documentType": { "const": "inputManifest" },
        "protocolVersion": { "const": 1 },
        "manifestVersion": { "const": 1 },
        "manifestIdentity": { "$ref": "#/$defs/sha256" },
        "inputSetIdentity": { "$ref": "#/$defs/sha256" },
        "requirementsIdentity": { "$ref": "#/$defs/opaqueIdentity" },
        "sourceIdentity": { "$ref": "#/$defs/opaqueIdentity" },
        "configurationIdentity": { "$ref": "#/$defs/opaqueIdentity" },
        "export": { "$ref": "#/$defs/exportInput" },
        "decision": { "$ref": "#/$defs/manifestDecision" },
        "objects": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/inputObject" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "properties": { "status": { "const": "available" } }
              }
            }
          },
          "then": {
            "required": ["inputSetIdentity"],
            "properties": {
              "export": {
                "properties": { "observationStatus": { "const": "proven" } }
              },
              "objects": {
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "mapping": {
                      "type": "object",
                      "properties": { "status": { "const": "proven" } }
                    }
                  }
                },
                "contains": {
                  "type": "object",
                  "required": ["role"],
                  "properties": { "role": { "const": "rawGeometry" } }
                }
              }
            }
          },
          "else": { "not": { "required": ["inputSetIdentity"] } }
        }
      ]
    },
    "identityBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageIdentity",
        "buildIdentity",
        "binaryIdentity",
        "dialectIdentity",
        "capabilityIdentities",
        "inputKindIdentity",
        "inputSchemaIdentity",
        "settingsIdentity",
        "settingsSchemaIdentity",
        "provenanceSetIdentity",
        "normalizationIdentity",
        "validationIdentity"
      ],
      "properties": {
        "packageIdentity": { "$ref": "#/$defs/opaqueIdentity" },
        "buildIdentity": { "$ref": "#/$defs/opaqueIdentity" },
        "binaryIdentity": { "$ref": "#/$defs/opaqueIdentity" },
        "dialectIdentity": { "$ref": "#/$defs/opaqueIdentity" },
        "capabilityIdentities": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/opaqueIdentity" }
        },
        "inputKindIdentity": { "$ref": "#/$defs/opaqueIdentity" },
        "inputSchemaIdentity": { "$ref": "#/$defs/opaqueIdentity" },
        "settingsIdentity": { "$ref": "#/$defs/opaqueIdentity" },
        "settingsSchemaIdentity": { "$ref": "#/$defs/opaqueIdentity" },
        "provenanceSetIdentity": { "$ref": "#/$defs/opaqueIdentity" },
        "normalizationIdentity": { "$ref": "#/$defs/opaqueIdentity" },
        "validationIdentity": { "$ref": "#/$defs/opaqueIdentity" }
      }
    },
    "manifestReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "manifestIdentity", "inputSetIdentity"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "manifestIdentity": { "$ref": "#/$defs/sha256" },
        "inputSetIdentity": { "$ref": "#/$defs/sha256" }
      }
    },
    "settingsInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["settingsIdentity", "schemaIdentity", "content"],
      "properties": {
        "settingsIdentity": { "$ref": "#/$defs/opaqueIdentity" },
        "schemaIdentity": { "$ref": "#/$defs/opaqueIdentity" },
        "content": { "$ref": "#/$defs/fileContent" }
      }
    },
    "outputDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outputIdentity", "role", "path", "mediaType", "maxByteLength"],
      "properties": {
        "outputIdentity": { "$ref": "#/$defs/opaqueIdentity" },
        "role": { "const": "generatedProject" },
        "path": { "$ref": "#/$defs/relativePath" },
        "mediaType": { "$ref": "#/$defs/mediaType" },
        "maxByteLength": { "$ref": "#/$defs/safeByteLength" }
      }
    },
    "generatorRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentType",
        "protocolVersion",
        "invocationIdentity",
        "expectedIdentities",
        "inputManifest",
        "settings",
        "output"
      ],
      "properties": {
        "documentType": { "const": "generatorRequest" },
        "protocolVersion": { "const": 1 },
        "invocationIdentity": { "$ref": "#/$defs/sha256" },
        "expectedIdentities": { "$ref": "#/$defs/identityBindings" },
        "inputManifest": { "$ref": "#/$defs/manifestReference" },
        "settings": { "$ref": "#/$defs/settingsInput" },
        "output": { "$ref": "#/$defs/outputDeclaration" }
      }
    },
    "diagnosticContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value"],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[!-~]+$"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "message", "context"],
      "properties": {
        "severity": { "enum": ["info", "warning"] },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9_-]+$"
        },
        "message": { "$ref": "#/$defs/boundedText" },
        "instancePath": {
          "type": "string",
          "maxLength": 1024,
          "pattern": "^(|/.*)$"
        },
        "context": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/diagnosticContext" }
        }
      }
    },
    "structuredError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "code", "message", "context"],
      "properties": {
        "category": {
          "enum": [
            "malformedRequest",
            "unsupportedRequest",
            "invalidInput",
            "generationFailed",
            "internalError"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9_-]+$"
        },
        "message": { "$ref": "#/$defs/boundedText" },
        "instancePath": {
          "type": "string",
          "maxLength": 1024,
          "pattern": "^(|/.*)$"
        },
        "context": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/diagnosticContext" }
        }
      }
    },
    "generatedOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outputIdentity",
        "role",
        "path",
        "mediaType",
        "byteLength",
        "sha256"
      ],
      "properties": {
        "outputIdentity": { "$ref": "#/$defs/opaqueIdentity" },
        "role": { "const": "generatedProject" },
        "path": { "$ref": "#/$defs/relativePath" },
        "mediaType": { "$ref": "#/$defs/mediaType" },
        "byteLength": { "$ref": "#/$defs/safeByteLength" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "generatorResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentType", "protocolVersion", "status", "diagnostics", "errors"],
      "properties": {
        "documentType": { "const": "generatorResult" },
        "protocolVersion": { "const": 1 },
        "status": { "enum": ["success", "failure"] },
        "invocationIdentity": { "$ref": "#/$defs/sha256" },
        "reportedIdentities": { "$ref": "#/$defs/identityBindings" },
        "output": { "$ref": "#/$defs/generatedOutput" },
        "diagnostics": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/diagnostic" }
        },
        "errors": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/structuredError" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "success" } } },
          "then": {
            "required": ["invocationIdentity", "reportedIdentities", "output"],
            "properties": { "errors": { "maxItems": 0 } }
          },
          "else": {
            "not": { "required": ["output"] },
            "properties": { "errors": { "minItems": 1 } }
          }
        }
      ]
    }
  }
}
